#!/bin/sh
# Reject a commit that would put an oversized blob or an unstripped executed
# notebook into history. Both checks read the staged blobs, not the working
# tree: the index is what the commit, and therefore the push, will carry.
# Install with `make install-hooks`.
set -e

PYTHON="${PYTHON:-python3}"
root="$(git rev-parse --show-toplevel)"

"$PYTHON" "$root/tools/check_large_files.py" --staged
"$PYTHON" "$root/tools/strip_notebook_stderr.py" --staged
